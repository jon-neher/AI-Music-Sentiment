    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
