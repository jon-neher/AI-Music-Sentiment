# Required: SQLAlchemy Postgres connection string.
# Use the psycopg driver. On Railway this is injected automatically by the
# Postgres plugin; see Railway docs for the exact variable format.
DATABASE_URL=
CORS_ORIGINS=*
ENVIRONMENT=dev

# Reddit (optional; enables Reddit ingest)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-sentiment-sonification/0.1

# NewsAPI (optional)
NEWSAPI_KEY=

# Models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

BACKFILL_START=2015-01-01
