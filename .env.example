# ---------------------------------------------------------------------------
# Postgres connection (SQLAlchemy URL using the psycopg driver; the scheme is
# "postgresql+psycopg" followed by standard URI credentials/host/database).
#
# Railway's Postgres plugin injects BOTH of the following automatically:
#   DATABASE_URL         -> private endpoint (*.railway.internal), used by
#                           services deployed inside the Railway network.
#   DATABASE_PUBLIC_URL  -> public TCP proxy (*.proxy.rlwy.net:PORT), reachable
#                           from Factory cloud machines, CI, and local dev.
#
# The app prefers DATABASE_URL when set and falls back to DATABASE_PUBLIC_URL,
# so you can keep both defined and things work in every environment.
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_PUBLIC_URL=
CORS_ORIGINS=*
ENVIRONMENT=dev

# Reddit (optional; enables Reddit ingest)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-sentiment-sonification/0.1

# NewsAPI (optional)
NEWSAPI_KEY=

# Models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

BACKFILL_START=2015-01-01
