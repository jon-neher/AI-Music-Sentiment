{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "api",
      "source": { "repo": ".", "rootDirectory": "api" },
      "build": { "builder": "DOCKERFILE", "dockerfilePath": "../infra/Dockerfile.api" },
      "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
        "healthcheckPath": "/healthz",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    {
      "name": "worker",
      "source": { "repo": ".", "rootDirectory": "worker" },
      "build": { "builder": "DOCKERFILE", "dockerfilePath": "../infra/Dockerfile.worker" },
      "deploy": {
        "startCommand": "python -m worker.schedule",
        "restartPolicyType": "ON_FAILURE"
      }
    },
    {
      "name": "web",
      "source": { "repo": ".", "rootDirectory": "web" },
      "build": { "builder": "NIXPACKS", "buildCommand": "npm ci && npm run build" },
      "deploy": {
        "startCommand": "npx serve -s dist -l ${PORT:-4173}",
        "restartPolicyType": "ON_FAILURE"
      }
    }
  ]
}
